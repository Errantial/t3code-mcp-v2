# Bearer token for the local T3 Code server. Mint one with:
#   npx t3@latest auth session issue --token-only --label t3code-mcp --ttl 365d
T3_TOKEN=

# Optional: override server origin (default: read from ~/.t3/userdata/server-runtime.json)
# T3_ORIGIN=http://127.0.0.1:3773

# Phase 3: bearer token required from clients when running with --http
# MCP_HTTP_TOKEN=
